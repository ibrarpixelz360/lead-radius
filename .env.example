APP_NAME="Customer Near Me"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Karachi

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=customernearme
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=pusher
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@customernearme.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# reCAPTCHA v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_THRESHOLD=0.5

# Scraping Infrastructure
BROWSERLESS_URL=http://browserless:3000
BROWSERLESS_TOKEN=
PROXY_PROVIDER=brightdata
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Manual Payment Bank Details
BANK_NAME="Meezan Bank"
BANK_ACCOUNT_TITLE="Customer Near Me Pvt Ltd"
BANK_ACCOUNT_NUMBER="01234567890"
BANK_IBAN="PK00MEZN0000000000000000"
BANK_BRANCH_CODE=""

# Affiliate Program
AFFILIATE_COMMISSION_PERCENT=30
AFFILIATE_RECURRING_PERCENT=20
AFFILIATE_HOLD_DAYS=14
AFFILIATE_MIN_WITHDRAWAL=1000
AFFILIATE_COOKIE_DAYS=90

# Plan Defaults
TRIAL_DAYS=7

# Search / Scout
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# Telescope (dev only)
TELESCOPE_ENABLED=true
